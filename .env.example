# Copy to .env and fill in. Never commit .env.
# Local Postgres from docker-compose.yml:
DATABASE_URL="postgresql://township:township@localhost:5433/township?schema=public"
# Neon gives a separate unpooled URL for migrations; locally it is the same:
DATABASE_URL_UNPOOLED="postgresql://township:township@localhost:5433/township?schema=public"
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Optional AI for complaint triage: set either key. With neither, the keyword fallback classifies.
# Gemini (Google AI Studio key):
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Claude (Anthropic API key):
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
# Only needed if both keys are set: "gemini" (default) or "claude".
AI_PROVIDER=""
# "true" shows the one-time code on the login screen (no SMS is sent). Keep on for review.
DEMO_MODE="true"
